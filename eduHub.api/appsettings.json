{
  "Jwt": {
    "Issuer": "eduHub",
    "Audience": "eduHub",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Resend": {
    "ApiKey": "",
    "FromEmail": "EduHub <onboarding@resend.dev>"
  },
  "PublicBaseUrl": "",
  "ForwardedHeaders": {
    "RequireKnownProxies": true,
    "TrustAll": false,
    "IngressLockedDown": false
  },
  "OpenTelemetry": {
    "ServiceName": "eduHub.api",
    "SamplingRatio": 1.0,
    "Otlp": {
      "Endpoint": ""
    }
  },
  "TokenCleanup": {
    "Enabled": true,
    "IntervalMinutes": 60
  },
  "RequestLogging": {
    "Enabled": true,
    "SlowRequestThresholdMs": 2000
  },
  "Startup": {
    "AutoMigrate": false,
    "AllowDangerousOperationsInProduction": false
  },
  "Seed": {
    "Enabled": false,
    "DefaultOrg": { "Slug": "k0n1w3hw" },
    "Admin": { "Enabled": false },
    "SampleData": { "Enabled": false }
  },
  "Reservations": {
    "Policy": {
      "LeadTimeMinutes": 60,
      "MaxAdvanceDays": 30,
      "SlotMinutes": 60,
      "MaxDurationMinutes": 60,
      "BufferMinutes": 15,
      "PendingExpiryHours": 24,
      "MaxPendingPerUser": 3,
      "GuestAccessHours": 24
    }
  }
}
